# Copy to .env and fill in real values. .env is gitignored.
# Vite inlines REACT_APP_*-prefixed vars into the client bundle (see vite.config.ts).

# --- Client: Firebase web config ---
REACT_APP_FINBERRY_API_KEY=
REACT_APP_FINBERRY_AUTH_DOM=
REACT_APP_FINBERRY_PROJECT_ID=
REACT_APP_FINBERRY_STORAGE_BUCKET=
REACT_APP_FINBERRY_MESSAGE_SENDER_ID=
REACT_APP_FINBERRY_APP_ID=

# Client: true => the app calls http://localhost:5000, otherwise the deployed server URL.
REACT_APP_FINBERRY_DEVELOPMENT=true

# --- Server (server/index.js reads these via dotenv; when running the server
#     from the server/ directory, put them in server/.env) ---
# MongoDB connection string (falls back to mongodb://localhost/finberry).
REACT_APP_DB=mongodb://localhost/finberry
# Twelve Data stock API key.
REACT_APP_FINBERRY_TWELVEDATA_API_KEY=
# Gates dev-only/admin server commands. Note this is SEPARATE from
# REACT_APP_FINBERRY_DEVELOPMENT above.
REACT_APP_DEVELOPMENT=true
# Server port.
PORT=5000
